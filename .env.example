# Global tuning — copy to `.env`.
# Per-account credentials live in `data/accounts.json` (managed via
# `python3 main.py accounts add`). This file only holds runtime knobs.

# --- daily budget ----------------------------------------------------------
# Server-side daily cap. Measured 30 in production; loosen only if the backend
# raises it. 0 disables the ceiling.
CONSO_DAILY_ZAP_CAP=30

# Per-credit ceiling for a single append_prompt. Payloads that compute above
# this are credited 0. Kept below the empirical 3.5 threshold.
CONSO_CREDIT_CEILING=3.2

# --- pacing ---------------------------------------------------------------
# Seconds between turns on one account (uniform draw in [min, max]).
CONSO_GAP_MIN=60
CONSO_GAP_MAX=180

# Extra jitter between accounts when running many in one wave, seconds.
CONSO_ACCOUNT_STAGGER=15

# Max accounts running append_prompt concurrently. 1 = strictly sequential.
CONSO_MAX_PARALLEL=4

# --- HTTP -----------------------------------------------------------------
CONSO_REQUEST_TIMEOUT=30
CONSO_MAX_RETRIES=3

# --- auth refresh ---------------------------------------------------------
# Refresh the access token this many seconds before its `exp`. 60 = one turn.
CONSO_REFRESH_LEEWAY=90

# --- dry-run --------------------------------------------------------------
# 1 = build and log payloads without posting.
CONSO_DRY_RUN=0

